  <script type="text/python" id="pythonSource">
import torch
import torch.nn as nn
import torch.nn.functional as F

class SpatialCNNEncoder(nn.Module):
    def __init__(self, in_channels=3, out_channels=128):
        super().__init__()
        self.conv1 = nn.Conv2d(in_channels, 64, kernel_size=7, stride=2, padding=3)
        self.bn1 = nn.BatchNorm2d(64)
        self.conv2 = nn.Conv2d(64, out_channels, kernel_size=3, stride=2, padding=1)
        self.bn2 = nn.BatchNorm2d(out_channels)
        self.relu = nn.GELU()

    def forward(self, x):
        return self.relu(self.bn2(self.conv2(self.relu(self.bn1(self.conv1(x))))))

class AttentionEncoder(nn.Module):
    def __init__(self, in_channels=3, embed_dim=128, num_heads=4):
        super().__init__()
        self.patch_embed = nn.Conv2d(in_channels, embed_dim, kernel_size=4, stride=4)
        self.attn = nn.MultiheadAttention(embed_dim=embed_dim, num_heads=num_heads, batch_first=True)
        self.norm = nn.LayerNorm(embed_dim)

    def forward(self, x):
        x = self.patch_embed(x)
        B, C, H, W = x.shape
        x = x.flatten(2).transpose(1, 2)
        attn_out, _ = self.attn(x, x, x)
        x = self.norm(x + attn_out)
        return x.transpose(1, 2).reshape(B, C, H, W)

class ReflexFusionBlock(nn.Module):
    def __init__(self, channels=128):
        super().__init__()
        self.gate = nn.Sequential(nn.Conv2d(channels * 2, channels, 1), nn.Sigmoid())
        self.fusion = nn.Conv2d(channels * 2, channels, 3, padding=1)

    def forward(self, cnn_feat, attn_feat):
        concat = torch.cat([cnn_feat, attn_feat], dim=1)
        w = self.gate(concat)
        fused = concat * torch.cat([w, 1 - w], dim=1)
        return F.gelu(self.fusion(fused))

class ReflexNetV1(nn.Module):
    def __init__(self, num_classes=21):
        super().__init__()
        self.cnn = SpatialCNNEncoder()
        self.attn = AttentionEncoder()
        self.rfb = ReflexFusionBlock()
        self.seg_head = nn.ConvTranspose2d(128, num_classes, kernel_size=4, stride=4)

    def forward(self, x):
        fused = self.rfb(self.cnn(x), self.attn(x))
        return self.seg_head(fused)
  </script>

