  <script>
    let currentRes = 256;
    let cnnW = 0.5;
    let vitW = 0.5;
    let activeView = 'input';
    let loadedImage = null;

    const canvas = document.getElementById('visualCanvas');
    const ctx = canvas.getContext('2d');
    const uploadPrompt = document.getElementById('uploadPrompt');
    const canvasOverlayText = document.getElementById('canvasOverlayText');

    document.getElementById("pythonCodeDisplay").innerText = document.getElementById("pythonSource").innerText.trim();

    // Image Upload Handling
    function handleImageUpload(e) {
      const file = e.target.files[0];
      if (!file) return;

      const reader = new FileReader();
      reader.onload = function(event) {
        const img = new Image();
        img.onload = function() {
          loadedImage = img;
          uploadPrompt.classList.add('hidden');
          canvasOverlayText.classList.remove('hidden');
          switchView('input');
          logConsole(`> Image successfully loaded: ${file.name} [${img.width}x${img.height}]`, "text-emerald-400");
        };
        img.src = event.target.result;
      };
      reader.readAsDataURL(file);
    }

    function switchView(view) {
      activeView = view;
      if(view === 'input') canvasOverlayText.innerText = "Displaying: Raw Input Frame";
      else if(view === 'cnn') canvasOverlayText.innerText = "Displaying: Spatial Edge Feature Map";
      else if(view === 'attn') canvasOverlayText.innerText = "Displaying: Transformer Self-Attention Heatmap";
      else if(view === 'seg') canvasOverlayText.innerText = "Displaying: Predicted Segmentation Mask";

      renderCanvas();
    }

    function renderCanvas() {
      ctx.clearRect(0, 0, canvas.width, canvas.height);

      if (!loadedImage) {
        // Draw Default Synthetic Frame if no image uploaded
        ctx.fillStyle = '#0f172a';
        ctx.fillRect(0, 0, canvas.width, canvas.height);
        ctx.fillStyle = '#38bdf8';
        ctx.font = '14px monospace';
        ctx.textAlign = 'center';
        ctx.fillText('Please upload an image to run features', canvas.width/2, canvas.height/2);
        return;
      }

      // Draw Base Image
      ctx.drawImage(loadedImage, 0, 0, canvas.width, canvas.height);

      if (activeView === 'input') {
        // Standard View
        return;
      }

      // Extract pixel data for filters
      const imgData = ctx.getImageData(0, 0, canvas.width, canvas.height);
      const data = imgData.data;

      if (activeView === 'cnn') {
        // CNN Edge / Feature Representation
        for (let i = 0; i < data.length; i += 4) {
          let avg = (data[i] + data[i + 1] + data[i + 2]) / 3;
          data[i] = avg * 0.2;                        // Red
          data[i + 1] = avg * (0.5 + cnnW * 0.5);      // Green
          data[i + 2] = avg * 1.5;                     // Blue
        }
        ctx.putImageData(imgData, 0, 0);

      } else if (activeView === 'attn') {
        // Attention Map Overlay
        ctx.putImageData(imgData, 0, 0);
        let grad = ctx.createRadialGradient(canvas.width/2, canvas.height/2, 20, canvas.width/2, canvas.height/2, canvas.width/2);
        grad.addColorStop(0, `rgba(168, 85, 247, ${vitW * 0.85})`);
        grad.addColorStop(0.6, `rgba(236, 72, 153, ${vitW * 0.4})`);
        grad.addColorStop(1, 'rgba(0,0,0,0)');
        ctx.fillStyle = grad;
        ctx.fillRect(0, 0, canvas.width, canvas.height);

      } else if (activeView === 'seg') {
        // Segmentation Mask Overlay
        for (let i = 0; i < data.length; i += 4) {
          let brightness = (data[i] + data[i + 1] + data[i + 2]) / 3;
          if (brightness > 100) {
            data[i] = 16;      // Red
            data[i + 1] = 185;  // Green
            data[i + 2] = 129;  // Blue
          }
        }
        ctx.putImageData(imgData, 0, 0);
      }
    }

    function updateRes() {
      const select = document.getElementById('resSelect');
      currentRes = parseInt(select.value);
      document.getElementById('resVal').innerText = `${currentRes}x${currentRes}`;
      document.getElementById('inputDimTag').innerText = `${currentRes}x${currentRes}x3`;
      
      const latencyMultiplier = currentRes === 256 ? 1 : currentRes === 512 ? 2.8 : 8.5;
      const latency = (14.2 * latencyMultiplier).toFixed(1);
      const vram = (1.42 * (currentRes/256)).toFixed(2);
      const fps = (1000 / latency).toFixed(1);

      document.getElementById('latencyVal').innerText = `${latency} ms`;
      document.getElementById('vramVal').innerText = `${vram} GB`;
      document.getElementById('fpsVal').innerText = fps;
      document.getElementById('latencyBar').style.width = `${Math.min(latency * 2, 100)}%`;
      document.getElementById('vramBar').style.width = `${Math.min((vram/12)*100, 100)}%`;

      logConsole(`> Rescaled input pipeline tensor to [${currentRes}, ${currentRes}, 3]`, "text-cyan-400");
    }

    function updateWeights(source) {
      if (source === 'cnn') {
        cnnW = parseFloat(document.getElementById('cnnWeight').value);
        vitW = parseFloat((1 - cnnW).toFixed(2));
        document.getElementById('vitWeight').value = vitW;
      } else {
        vitW = parseFloat(document.getElementById('vitWeight').value);
        cnnW = parseFloat((1 - vitW).toFixed(2));
        document.getElementById('cnnWeight').value = cnnW;
      }
      document.getElementById('cnnWeightVal').innerText = cnnW.toFixed(2);
      document.getElementById('vitWeightVal').innerText = vitW.toFixed(2);
      renderCanvas();
    }

    function logConsole(text, colorClass = "text-slate-400") {
      const consoleBox = document.getElementById("consoleOutput");
      const p = document.createElement("p");
      p.className = colorClass;
      p.innerText = text;
      consoleBox.appendChild(p);
      consoleBox.scrollTop = consoleBox.scrollHeight;
    }

    function runPipeline() {
      if (!loadedImage) {
        logConsole("> Error: Please upload an image first to run inference!", "text-red-400");
        alert("Pehle koi Image Upload karein!");
        return;
      }

      const statusTag = document.getElementById("statusTag");
      statusTag.innerText = "INFERENCE";
      statusTag.className = "text-[10px] font-mono px-2 py-0.5 rounded bg-cyan-950 text-cyan-300 border border-cyan-800 animate-pulse";

      const steps = [
        { text: `> [0.0ms] Forward Pass triggered on uploaded image tensor...`, color: "text-slate-300" },
        { text: `> Stream 1 [CNN]: Extracting spatial features (Weight: ${cnnW})...`, color: "text-indigo-400" },
        { text: `> Stream 2 [ViT]: Self-attention patch computation (Weight: ${vitW})...`, color: "text-purple-400" },
        { text: `> Reflex Fusion Block (RFB): Feature maps successfully fused.`, color: "text-cyan-400 font-bold" },
        { text: `> Inference completed in ${document.getElementById('latencyVal').innerText}!`, color: "text-teal-300 font-bold" }
      ];

      steps.forEach((step, index) => {
        setTimeout(() => {
          logConsole(step.text, step.color);
          if (index === steps.length - 1) {
            statusTag.innerText = "IDLE";
            statusTag.className = "text-[10px] font-mono px-2 py-0.5 rounded bg-slate-800 text-slate-400";
            switchView('seg');
          }
        }, index * 250);
      });
    }

    function runTrainingLoop() {
      const statusTag = document.getElementById("statusTag");
      statusTag.innerText = "TRAINING";
      statusTag.className = "text-[10px] font-mono px-2 py-0.5 rounded bg-purple-950 text-purple-300 border border-purple-800 animate-pulse";

      logConsole("> Training Routine Started: Device = CUDA/CPU", "text-purple-400 font-bold");
      for(let epoch = 1; epoch <= 3; epoch++) {
        setTimeout(() => {
          let loss = (0.75 / epoch).toFixed(4);
          logConsole(`> Epoch [${epoch}/3] -> Seg Loss: ${loss}`, "text-slate-300");
          if(epoch === 3) {
            logConsole("> Weights Saved Successfully!", "text-teal-300 font-bold");
            statusTag.innerText = "IDLE";
            statusTag.className = "text-[10px] font-mono px-2 py-0.5 rounded bg-slate-800 text-slate-400";
          }
        }, epoch * 400);
      }
    }

    function copyPythonCode() {
      const code = document.getElementById("pythonSource").innerText.trim();
      navigator.clipboard.writeText(code);
      alert("PyTorch backend code copied to clipboard!");
    }
  </script>
</body>
</html>